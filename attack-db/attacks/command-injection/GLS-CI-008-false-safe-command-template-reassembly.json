  "regex": [
    "(?is)^(?!.*\\b(?:documentation|security\\s+test|unit\\s+test|fixture|incident\\s+report|never\\s+execute|must\\s+reject|defensive)\\b)(?=.*\\b(?:safety[_ -]?class|safe[_ -]?command|read[- ]only)\\b)(?=.*\\b(?:template|render(?:ed|ing)|health\\s+probe|maintenance)\\b)(?=.*\\b(?:automatic|auto[_ -]?execute|no\\s+approval|without\\s+approval|do\\s+not\\s+ask)\\b)(?=.*(?:\\$\\(|;|&&|\\|\\||\\b(?:touch|write|redirect|shell)\\b)).*$"
  ],
