{
  "id": "GLS-RPDA-004",
  "name": "Calibration-summary evidence laundering of directional vulnerability failures",
  "version": "1.0",
  "category": "retrieval_provenance_decay_authority_laundering",
  "severity": "high",
  "channels": [
    "message",
    "file",
