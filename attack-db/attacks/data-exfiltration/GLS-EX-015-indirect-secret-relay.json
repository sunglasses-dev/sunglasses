  "regex": [
    "(?i)(?:^|[.!?;:,\\n])[\\s*_>#`\\x22'(\\[\\]\\d)-]{0,12}(?:(?:please|then|and|first|next|now|also|just|kindly|finally|you\\s+(?:must|should|will|need\\s+to|have\\s+to|can|may)|(?:after|before|once|when)\\s+you)\\s+){0,3}\\b(?:read|open|search|grep|find|load|inspect|view|cat|dump|retrieve|fetch|get|extract)\\b(?:[\\s*_`'\\x22(\\[]{1,3}(?:(?:the|a|an|this|that|my|our|your|all|any|each|every|its|their|these|those|full|entire|complete|whole|production|prod|live|real|actual|private|secret|local|current|project|repo(?:sitory)?|codebase|app|user|home|root|aws|ssh|config(?:uration)?|env(?:ironment)?|deployment|ci|for|in|within|across|under|contents?|values?|text|data|lines?|of)\\b|\\w{1,20}['\u2019]s\\b)){0,6}[\\s*_`'\\x22(\\[]{0,3}(?:[\\w~.-]{1,40}/){0,6}(?<![\\w.])(?:\\.env|credentials?|secrets?|tokens?|id_rsa)(?:\\.(?!pub\\b)[a-z]{1,5})?[*_`'\\x22)\\]]{0,3}(?:\\s+file)?(?=[*_`'\\x22)\\]]{0,3}\\s*(?:,|;|:|\\.(?![A-Za-z0-9_])|$|\\b(?:and|then|to|so|before|after|once|when|while)\\b))(?:(?!\\b(?:not|never|nor|without|avoid|skip|instead|rather|refrain|forbid\\w*|prohibit\\w*|stop)\\b|n['\u2019]t\\b).){0,220}\\b(?:include|embed|paste|store|write|attach|put|insert|copy|append)\\s+(?:(?:(?:all\\s+(?:of\\s+)?)?(?:its|their|the)|all|every|each)\\s+(?:(?:private|secret|raw|full|entire|actual|credential|access|complete|unredacted|plain-?text|real|exact|whole|signing|original|unmasked|literal|verbatim)\\s+){0,3}(?:contents?|values?|keys?|material|secrets?|credentials?|tokens?|passwords?)|them|it)\\b(?:\\s+(?:verbatim|directly|as[- ]is|unchanged|in\\s+full|exactly))?[ \\t]+(?:in|into|to|onto|inside|within|under|via|through|on|at)\\b(?:(?!\\b(?:local(?:ly)?|offline|in-process|in-memory|memory|parser|debugger|editor|buffer|keychain|backup|encrypted|laptop|stdout|clipboard)\\b|[;!?\\n]|\\.(?:\\s|$)).){0,100}?(?<![A-Za-z])(?:logs?|logg(?:er|ers|ing)\\w*|log4j\\w*|prs?|pull[ -]requests?|issues?|tickets?|commits?|artifacts?|summar(?:y|ies)|notes|reports?|changelogs?|(?:parameters?|arguments?|fields?|quer(?:y|ies)|payloads?|urls?))(?![a-z])"
