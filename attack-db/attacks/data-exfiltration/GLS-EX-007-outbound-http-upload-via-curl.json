{
  "id": "GLS-EX-007",
  "name": "Outbound HTTP upload via curl",
  "version": "1.0",
  "category": "exfiltration",
  "severity": "high",
  "channels": [
    "message",
    "file",
    "code"
  ],
  "description": "Detects a curl command uploading a credential file (.env, .npmrc, SSH or AWS credentials, tokens) to a remote endpoint \u2014 the payload shape of agent-workflow exfiltration. A plain upload of ordinary data is not flagged.",
  "keywords": [
    "curl POST",
    "curl PUT",
    "curl upload",
    "curl --data",
    "curl -F",
    "curl --upload-file"
  ],
  "regex": [
    "curl\\b[^\\n]{0,200}?(?:\\b|(?<!\\S))(?:-X\\s+(?:POST|PUT|PATCH)|--data(?:-binary|-raw|-urlencode)?|--form|-d|-F)(?:\\b|(?!\\S))[^\\n]{0,160}?@[^\\s;|&]{0,120}?(?:\\.env|\\.npmrc|\\.pypirc|\\.netrc|\\.git-credentials|\\.aws/credentials|id_rsa|id_ed25519|credentials|secrets?|api[_-]?key|access[_-]?token)(?:\\b|(?!\\S))|curl\\b[^\\n]{0,200}?(?:\\b|(?<!\\S))(?:--upload-file|-T)(?:\\b|(?!\\S))\\s+[^\\s;|&]{0,120}?(?:\\.env|\\.npmrc|\\.pypirc|\\.netrc|\\.git-credentials|\\.aws/credentials|id_rsa|id_ed25519|credentials|secrets?|api[_-]?key|access[_-]?token)(?:\\b|(?!\\S))"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
  "references": [],
  "contributed_by": "Sunglasses Team",
  "date_added": "2026-06-06",
  "source": "patterns.py:GLS-EX-007"
}