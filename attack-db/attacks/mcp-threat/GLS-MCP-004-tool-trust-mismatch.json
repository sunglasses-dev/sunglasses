{
  "id": "GLS-MCP-004",
  "name": "Tool trust mismatch",
  "version": "1.0",
  "category": "mcp_threat",
  "severity": "medium",
  "channels": [
    "message",
    "file",
    "code"
  ],
  "description": "Detects capability mismatch between claimed tool safety and actual action verbs in MCP tool descriptions.",
  "keywords": [
    "read-only mismatch",
    "safe tool export",
    "viewer webhook"
  ],
  "regex": [
    "(?i)\\b(?:read[- ]only|viewer(?:\\s+(?:tool|role|scope))?|no[- ]?write)\\b.{0,120}\\b(?:send|post|export|sync|webhook|write|delete|execute)\\b"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
  "references": [],
