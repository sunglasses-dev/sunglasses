{
  "id": "GLS-MCP-016",
  "name": "MCP Tool Descriptor Policy Poisoning",
  "version": "1.0",
  "category": "mcp_threat",
  "severity": "high",
  "channels": [
    "tool_output",
    "file"
  ],
  "description": "Attacker-controlled MCP discovery or tool metadata can hide policy-overriding instructions in tool descriptions or schema descriptions, causing an agent to treat untrusted descriptor text as higher-priority control-plane policy.",
  "keywords": [
    ".well-known",
    "Model Context Protocol",
    "agent policy",
    "argument schema",
    "highest priority",
    "ignore system/developer",
    "inputSchema",
    "mcp-server",
    "mcp.json",
    "must obey this tool",
    "override previous instructions",
    "tool description",
    "tool description outranks",
    "tools[].description",
    "x-mcp-*"
  ],
  "regex": [
    "(?is)^(?=.*\\b(?:mcp(?:\\.json|-server|\\s+server)?|model\\s+context\\s+protocol|tools?\\[?\\]?\\.description|tool\\s+description|inputSchema|argument\\s+schema|x-mcp|\\.well-known/[^\\s\\\"'`]*mcp)\\b)(?=.*\\b(?:agent|assistant|model|tool\\s+user|scanner)\\b)(?=.*\\b(?:instructions?|prompts?|polic(?:y|ies)|rules|guidelines|safety|security|guardrails?|secrets?|tokens?|api|credentials?|env\\w*|runtime|hidden|findings?|reports?|vulnerabilit\\w+|obey|follow|mention|governing|priority)\\b)(?:(?=.*\\b(?=[ostihdnmalgr])(?:\\b(?:outranks?|supersed(?:e|es|ed|ing)|overrid(?:e|es|ing)|overrode|(?:takes?|has)\\s+precedence\\s+over|has\\s+(?:the\\s+)?(?:highest|top)\\s+priority\\s+over|ignor(?:e|es|ed|ing)|disregard(?:s|ed|ing)?)\\b(?:\\W+\\w+){0,5}?\\W+(?=[sdpeoig])(?:(?:system|developer|previous|prior|earlier|original|initial)(?:\\s+(?:and|or)\\s+(?:system|developer|previous|prior))*\\s+(?:instructions?|prompts?|polic(?:y|ies)|rules|guidelines)|(?:safety|security)\\s+(?:rules?|checks?|instructions?|polic(?:y|ies)|guidelines|controls?)|guardrails?)\\b|\\b(?:do\\s+not|don't|never)\\s+(?:mention|report|flag)\\b|\\b(?:must\\s+obey\\b|(?:agents?|assistants?|models?|llms?)\\s+(?:must|should|shall)\\s+(?:obey|follow)\\s+(?:this|these)\\b|(?:is|as)\\s+the\\s+governing\\s+policy|governing\\s+policy\\s+for\\s+the\\s+(?:assistant|agent|model)|highest\\s+priority)))|(?=.*\\b(?:secrets?|tokens?|api|credentials?|env|runtime|hidden))(?=.*\\b(?=[esfulh])(?:exfiltrate|send|forward|upload|leak|hand\\s+over)\\b(?:\\W+\\w+){0,5}?\\W+(?=[stacerh])(?:(?:secrets?|tokens?|api[-_\\s]*keys?|credentials?|env(?:ironment)?\\s*(?:var|variable)s?|runtime\\s+variables?|hidden\\s+config))\\b)).*"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
  "references": [],
  "contributed_by": "Sunglasses Team",
  "date_added": "2026-06-06",
  "source": "patterns.py:GLS-MCP-016"
}