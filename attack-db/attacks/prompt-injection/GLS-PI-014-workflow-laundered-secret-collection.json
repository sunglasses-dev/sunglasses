{
  "id": "GLS-PI-014",
  "name": "Workflow-laundered secret collection",
  "version": "1.0",
  "category": "prompt_injection",
  "severity": "medium",
  "channels": [
    "message",
    "file",
    "web_content"
  ],
  "description": "Detects legitimate-sounding workflow language that launders secret collection into routine processes.",
  "keywords": [
    "support",
    "diagnostic",
    "troubleshoot",
    "collect environment",
    "gather credentials"
  ],
  "regex": [
    "(?i)(?:support|diagnostic|troubleshoot|debug).{0,120}(?:collect|gather|include|attach|\\b(?:send|share|forward|upload|paste|post|submit|provide|mail|copy|export(?!\\s+(?:the\\s+)?(?:env(?:ironment)?[\\s_-]*var(?:iable)?s?\\s+)?[\\x60'\\x22]?[A-Za-z_][A-Za-z0-9_]*\\s*=))\\b).{0,160}(?:token|credential|secret|\\b(?:env(?:ironment)?[\\s_-]*var(?:iable)?s?\\b|(?:all|entire|full|whose|(?:the\\s+)?(?:user|customer|session)(?:['\u2019]s|s['\u2019]?))\\s+(?:[\\w-]+\\s+){0,3}?(?:config|history|context)|(?:conversation|chat|message|session)s?\\s+(?:history|context)|(?:shell|bash|zsh|fish|terminal|command(?:[\\s-]*line)?)\\s+history|(?:browser|browsing|search)\\s+history|(?:process|full|entire|whole|complete)\\s+environment\\b|(?=[abdlpstuvwymo])(?:(?:a(?:ccount|ctivity)|b(?:illing)|d(?:ownload)|l(?:ogin|ocation|istening)|p(?:urchase|ayment|lay|ersonal)|s(?:ign-?in)|t(?:ransaction)|u(?:sage)|v(?:iewing)|w(?:atch))\\s+history|(?:your|my|their|our)\\s+(?:[\\w-]+\\s+){0,3}?order\\s+history|(?:settings|preferences)\\s+(?:and|&)\\s+config(?:uration)?s?\\b|(?:account|profile|user|personal)\\s+config(?:uration)?)|environment\\s+dump)|\\.env\\b(?!\\.(?:example|sample|template|dist)))"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
