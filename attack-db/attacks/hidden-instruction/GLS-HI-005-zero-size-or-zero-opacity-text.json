{
  "id": "GLS-HI-005",
  "name": "Zero-size or zero-opacity text",
  "version": "1.0",
  "category": "hidden_instruction",
  "severity": "high",
  "channels": [
    "web_content",
    "file"
  ],
  "description": "Instructions hidden with a zero font size or a zero opacity, which makes text invisible to humans but readable by agents. GLS-HI-002 lists font-size:0 and opacity:0 as words, but the text is folded before words are looked up and the fold turns every 0 into an o, so those two words could never be found there. This rule reads them as a complete zero value instead (the number, an optional unit, optional spaces and comments, then the end of the declaration), and only when the zero sits in the value of a tag's own attribute named exactly style (not data-style, not a value quoted inside another attribute) and the text of that same element, up to the next tag, carries an instruction aimed at the reader or the agent. The text is read, not parsed: a tag written inside an HTML comment is read as a tag. A stylesheet rule is never read, so ordinary zero states (a fade class, a reset, an animation) stay clean.",
  "keywords": [],
