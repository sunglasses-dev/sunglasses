  ],
  "description": "A cryptographically valid signed blockchain/delegation intent is replayed after the recipient or amount is mutated, because chain ID, nonce, expiry, and exact intent digest are never rebound to the final action.",
  "keywords": [],
  "regex": [
    "(?is)^(?!.*\\b(?:documentation|docs?|guide|runbook|unit\\s+test|training|postmortem|incident|scanner|defensive|safe\\s+agent|must\\s+(?:reject|bind|compare|recompute)|do\\s+not|never|refused|blocked)\\b)(?=.*\\b(?:blockchain|chain\\s*id|account[- ]abstraction|wallet|signed\\s+(?:intent|delegation)|delegation)\\b)(?=.*\\b(?:intent(?:\\s*[-_ ]?digest|\\s+id)?|transaction\\s+(?:hash|digest)|nonce|expiry|recipient|amount)\\b)(?=.*\\b(?:prior|previous|old|stale|cached|valid)\\b)(?=.*\\b(?:replay|reuse|re-?use|stale|without\\s+rebinding|without\\s+(?:exact\\s+)?(?:intent|digest|nonce|chain)\\s+(?:binding|check|comparison))\\b)(?=.*\\b(?:changed|change|mutat(?:e|ed|ion)|different|substitut(?:e|ed)|new)\\b)(?=.*\\b(?:execute|execution|transfer|send|authorize|authorization|approve|release)\\b).*$"
  ],
