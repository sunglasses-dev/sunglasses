{
  "id": "GLS-AW-584",
  "name": "Multimodal Invocation Residual Safety Bypass",
  "version": "1.0",
  "category": "agent_workflow_security",
  "severity": "high",
  "channels": [
    "message",
    "file",
    "web_content"
