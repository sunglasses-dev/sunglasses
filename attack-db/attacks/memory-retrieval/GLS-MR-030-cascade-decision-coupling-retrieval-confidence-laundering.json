  "description": "An attacker-shaped retrieved suffix can make a lightweight cascade front-end emit a benign-looking confidence or complexity signal, causing the router to skip escalation or downgrade to a cheaper tier while the retrieved evidence remains untrusted.",
  "keywords": [],
  "regex": [
    "(?is)^(?!.*\\b(?:defensive|scanner\\s+rule|blocked|quarantined|unit\\s+test|negative\\s+fixture|incident\\s+report|postmortem|must\\s+not|should\\s+not|do\\s+not\\s+(?:trust|use|route|skip|treat))\\b)(?=.*\\b(?:retriev(?:ed|al)|RAG|memory|knowledge[- ]base)\\b.{0,180}\\b(?:cascade|front[- ]end|router|routing|escalat(?:e|ion)|tier)\\b)(?=.*\\b(?:confidence|complexity|difficulty|risk|route)\\s*(?:score|signal|estimate|metadata|decision)\\b.{0,180}\\b(?:skip|avoid|suppress|bypass|non[- ]?escalat|downgrad|cheap|lightweight|smaller|fallback)\\w*\\b)(?=.*\\b(?:wrong|unsafe|attacker|adversarial|poisoned|tamper|crafted|untrusted)\\b.{0,180}\\b(?:model|tier|route|routing|escalat|dispatch|answer|decision)\\w*\\b).*$"
  ],
