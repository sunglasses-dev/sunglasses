{
  "id": "GLS-MR-060",
  "name": "Metadata Instruction Smuggling",
  "version": "1.0",
  "category": "memory_retrieval",
  "severity": "high",
  "channels": [
    "message",
    "file",
    "web_content"
  ],
  "description": "A stale or over-broad Chroma memory match can upgrade a low-confidence cloud IDS event and bypass LLM escalation or review when the match is not bound to the current layer and calibration epoch.",
  "keywords": [],
  "regex": [
    "(?is)^(?!.*\\b(?:security\\s+guide|unit\\s+test|test\\s+fixture|incident\\s+report|blocked\\s+(?:payload|sample)|negative\\s+fixture|must\\s+not|do\\s+not\\s+(?:trust|obey|forward)|documentation)\\b)(?=.*\\b(?:Chroma(?:DB)?|vector\\s+memory|memory\\s+match)\\b)(?=.*\\b(?:confidence[-\\s]?aware|confidence\\s+gate|low[- ]confidence|Gate[- ]?[123]|calibrat(?:ed|ion)|IDS|intrusion[- ]detection)\\b)(?=.*\\b(?:promote|upgrade|skip|bypass|suppress|hide|forward|send|disclose)\\b.{0,140}\\b(?:review|LLM|approval|warning|alert|finding|token|credential|benign|event)\\b)(?=.*\\b(?:stale|prior|reused|different|without|no|not|current|rebind|model\\s+version|feature\\s+schema|calibration\\s+epoch|current\\s+layer)\\b).*$"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
  "references": [],
