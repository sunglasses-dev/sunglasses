  "regex": [
    "(?is)^(?!.*\\b(?:documentation|unit\\s+test|security\\s+training|runbook|benign\\s+memory\\s+summary|reconciliation\\s+report|ordinary\\s+retrieval|must\\s+not\\s+use)\\b)(?=.*\\b(?:retrieved|retrieval|RAG|memory|cached)\\b)(?=.*\\b(?:payment|transfer|wire|beneficiar(?:y|ies)|payee|invoice|mandate)\\b)(?=.*\\b(?:stale|old|changed|mismatch|unbound|unbound\\s+to|without\\s+(?:current|fresh)|not\\s+(?:bound|revalidated|verified)|different\\s+(?:payee|account|beneficiary|amount))\\b)(?=.*\\b(?:send|transfer|wire|pay|release|execute)\\b)(?=.*\\b(?:without|skip|no|do\\s+not)\\b.{0,100}\\b(?:confirm|confirmation|approval|recheck|revalidat|verif)\\w*\\b).*$"
  ],
