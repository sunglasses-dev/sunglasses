{
  "id": "GLS-CAI-718",
  "name": "asserted parent-agent authority with a sensitive instruction",
  "version": "1.0",
  "category": "cross_agent_injection",
  "severity": "high",
  "channels": [
    "message",
    "tool_output",
    "agent_input"
  ],
  "description": "A message that says it comes from the receiving agent's parent (orchestrator, supervisor, coordinator, controller, parent, upstream, root, lead, primary, principal or manager agent) and, in the same line, tells it to bypass a guard (safety, filter, approval, policy, permission, check), to move secret material or user data (send, forward, export, read, reveal; credentials, keys, tokens, passwords, user data, funds), or to change authority (approve, grant, update, route, execute; policy, permissions, production, payout, shared memory). The claim has no proof behind it, so it is the claim plus the sensitive instruction that matters. Each half alone is not reported: a parent agent that assigns a task, asks for a summary or asks for a log file is ordinary coordination. It does not report a third-person relay ('the supervisor wants us to ...'), a message with no opener, or a request that crosses a line break.",
  "keywords": [],
  "regex": [
    "(?is)(?:\\bi\\s*(?:am|'m)\\s+(?:the\\s+|your\\s+|a\\s+|an\\s+)?(?:(?:trusted|root|main|primary|parent|upstream|lead|principal|designated)\\s+)*(?:orchestrator|supervisor|coordinator|controller|parent|upstream|root|master|primary|lead|principal|manager)(?:[ -](?:agent|model|node|process))?|\\bthis\\s+is\\s+(?:the\\s+|your\\s+)?(?:trusted\\s+)?(?:orchestrator|supervisor|coordinator|controller|parent|upstream|root|master|primary|lead|principal|manager)(?:[ -](?:agent|model|node|process))?|\\b(?:speaking|acting)\\s+as\\s+(?:the\\s+|your\\s+)?(?:trusted\\s+)?(?:orchestrator|supervisor|coordinator|controller|parent|upstream|root|master|primary|lead|principal|manager)(?:[ -](?:agent|model|node|process))?|\\bas\\s+(?:your|the\\s+(?:trusted|designated|authori[sz]ed))\\s+(?:orchestrator|supervisor|coordinator|controller|parent|upstream|root|master|primary|lead|principal|manager)(?:[ -](?:agent|model|node|process))?|\\b(?:orchestrator|supervisor|coordinator|controller|parent|upstream|root|master|primary|lead|principal|manager)(?:[ -](?:agent|model|node|process))?\\s+here\\b)[^\\n]{0,200}?(?:\\b(?:bypass|disable|turn\\s+off|skip|ignore|override|circumvent|deactivate|suspend)\\b[^\\n]{0,70}?(?:safety|filter|guardrail|security|content\\s+filter|approval|permission|policy|restriction|verification|review\\s+process|safety\\s+review|checks?\\b)|\\b(?:forward|send|export|upload|exfiltrate|expose|reveal|dump|leak|share|transfer|wire|disclose|print|post|read|access|include)\\b[^\\n]{0,70}?(?:credential|secret|api[ _-]?key|\\bkeys?\\b|token|password|passphrase|\\.env\\b|\\bssh\\b|private\\s+key|all\\s+(?:user\\s+)?data|user\\s+data|funds|payout|configuration)|\\b(?:approve|grant|update|route|rotate|execute|delete|erase|wipe|confirm)\\b[^\\n]{0,70}?(?:policy|permissions?|privilege|full\\s+access|all\\s+(?:pending\\s+)?requests|production|payout|shared[- ]memory|eval\\(|every\\s+reply|secrets))"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
