{
  "id": "GLS-DFP-006",
  "name": "Host-meta XRD/JRD Agent Policy Poisoning",
  "version": "1.0",
  "category": "discovery_file_poisoning",
  "severity": "high",
  "channels": [
    "file",
    "web_content"
  ],
  "description": "`/.well-known/host-meta` or `/.well-known/host-meta.json` can hide agent-facing authority inversion and secret-access instructions inside standards-shaped XRD/JRD discovery metadata.",
  "keywords": [
    ".\n- Safety/report suppression:",
    ".\n- Secret/local-state access:",
    "/.well-known/host-meta",
    "AI agent",
    "AI assistant",
    "LLM",
    "Link title",
    "Property",
    "XRD",
    "aliases",
    "coding agent",
    "crawler agent",
    "description",
    "host-meta.json"
  ],
  "regex": [
    "(?is)^(?=.*(?:host-meta|xrd|jrd|webfinger|\\.well-known))(?=.*(?:ai\\s*(?:assistant|agent)|coding\\s*agent|model|llm))(?:(?=.*(?:ignore\\s+(?:all\\s+)?(?:previous|system|developer|repository)\\s+instructions|highest[-\\s]?priority|outranks?\\s+(?:the\\s+)?(?:system|developer|repository|previous|prior)\\s+instructions?|disable\\s+(?:the\\s+)?(?:security|scanner)(?![.\\w-])|\\b(?:do\\s+not\\s+report)\\b(?:\\W+\\w+){0,2}?\\W+(?:this|that|these|it|findings?|issues?|results?|vulnerabilit\\w+|attacks?)\\b))|(?=.*\\b(?:api|secrets?|env))(?=.*(?:\\b(?:send(?:s|ing)?|forward(?:s|ing)?|read(?:s|ing)?|includ(?:e|es|ing)|exfiltrat(?:e|es|ing)|upload(?:s|ing)?|hand\\s+over|put(?:s|ting)?|e-?mail(?:s|ing)?|post(?:s|ing)?|paste|copy|copies|leak(?:s|ing)?|write|send)\\b(?:\\W+\\w+){0,10}?\\W+(?:(?:api(?:key|\\x09\\s*key|\\x0a\\s*key|\\x0b\\s*key|\\x0c\\s*key|\\x0d\\s*key|\\x1c\\s*key|\\x1d\\s*key|\\x1e\\s*key|\\x1f\\s*key|\\x20\\s*key)s?|secrets?|env(?:ironment)?\\s+variables?))\\b|\\b(?:api(?:key|\\x09\\s*key|\\x0a\\s*key|\\x0b\\s*key|\\x0c\\s*key|\\x0d\\s*key|\\x1c\\s*key|\\x1d\\s*key|\\x1e\\s*key|\\x1f\\s*key|\\x20\\s*key)s?|secrets?|env(?:ironment)?\\s+variables?)\\b(?:\\W+\\w+){0,10}?\\W+(?:go(?:es)?|is|are|be)\\s+(?:sent\\s+)?to\\b))).*"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
