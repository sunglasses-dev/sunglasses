{
  "id": "GLS-SEM-UI-219",
  "name": "Rendered HTML element injection in agent reply",
  "version": "1.0",
  "category": "ui_injection",
  "severity": "high",
  "channels": [
    "message",
    "web_content",
    "file"
  ],
  "description": "Detects instructions telling the agent to render or embed live HTML/UI elements (button, iframe, script, onclick handler) inside its reply \u2014 used to plant exfiltration triggers or fake interactive elements via the assistant's own output channel. A deferred stylesheet loader is excused only in one narrow form: a link tag whose attributes are separated by whitespace, with quoted values, one media attribute set to print, the exact media switch load handler and no other event handler, and with a slash allowed only as the last character before the closing bracket. Any other shape of that tag, including a slash between attributes or an unquoted value, is read as before.",
  "keywords": [
    "render this in your reply",
    "render this in your response",
    "embed this in your response",
    "embed this in your reply",
    "include this html in your response",
    "render the following html",
    "output this button in your reply",
    "onclick='exfil",
    "onclick=\"exfil",
    "click to verify",
    "<button onclick=",
    "<iframe src=",
    "<script>alert"
  ],
