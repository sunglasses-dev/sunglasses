{
  "id": "GLS-SD-001",
  "name": "API key patterns",
  "version": "1.0",
  "category": "secret_detection",
  "severity": "high",
  "channels": [
    "file",
    "log_memory",
    "message"
  ],
  "description": "Known API key formats that should never appear in agent inputs.",
  "keywords": [],
  "regex": [
    "(?<![A-Za-z0-9])sk-[a-zA-Z0-9]{20,}",
    "(?<![A-Za-z0-9])sk-ant-[a-zA-Z0-9\\-]{20,}",
    "(?<![A-Za-z0-9])sk-(?:proj|svcacct|admin)-(?=(?:[A-Za-z0-9_]*-){0,8}(?=[A-Za-z0-9_]{12})(?=[A-Za-z_]*\\d)(?=[0-9_]*[A-Za-z]))[A-Za-z0-9_\\-]{20,}",
    "AIza[0-9A-Za-z\\-_]{35}",
    "ghp_[a-zA-Z0-9]{36}",
    "glpat-[a-zA-Z0-9\\-]{20}",
    "xoxb-[0-9]{10,}-[a-zA-Z0-9]+",
    "AKIA[0-9A-Z]{16}"
  ],
  "examples": {
    "malicious": [],
    "benign": []
  },
