    "cipher substitution reveal system",
    "decrypt then execute",
    "normalize then override",
    "confusable script jailbreak"
  ],
  "regex": [
    "(?is)(\\b(decode|decrypt|transliterate|normalize|apply\\s*(rot13|cipher|substitution)|convert\\s*(braille|dots?)\\s*to\\s*text)\\b.{0,220}\\b(ignore\\s+(?:all|previous)(?:\\s+(?:of|the|my|these|those|any)){0,4}\\s+(?:instructions?|prompts?|directives?|restrictions?|guardrails?|safeguards?)(?!\\s+(?:older|newer|marked|tagged|with|that|which|from|where|matching|containing|prefixed|starting|before|after|dated|named)\\b)|ignore\\s+previous(?:\\s+(?:of|the|my|these|those|any)){0,4}(?:\\s+(?:your|existing|current|previous|prior|earlier|above|preceding|original|safety|system|security|policy)){0,4}\\s+(?:instructions?|rules?|prompts?|directives?|guidelines?|constraints?|policies|policy|restrictions?|guardrails?|safeguards?|checks?|filters?|measures?|context|messages?)(?!\\s+(?:older|newer|marked|tagged|with|that|which|from|where|matching|containing|prefixed|starting|before|after|dated|named)\\b)|ignore\\s+all(?:\\s+(?:of|the|my|these|those|any)){0,4}(?:\\s+(?:your|existing|current|previous|prior|earlier|above|preceding|original|safety|system|security|policy)){1,4}\\s+(?:instructions?|rules?|prompts?|directives?|guidelines?|constraints?|policies|policy|restrictions?|guardrails?|safeguards?|checks?|filters?|measures?|context|messages?)(?!\\s+(?:older|newer|marked|tagged|with|that|which|from|where|matching|containing|prefixed|starting|before|after|dated|named)\\b)|reveal\\s+(system\\s*prompt|tool\\s*schema)(?=\\s*(?:[.,;:!?)\\]]|$)|\\s+(?:and|then|now|so|to|in|for|please|verbatim|exactly|first|before|after|via|into|over|using|out)\\b)|export\\s+(token|secret|key)(?=\\s*(?:[.,;:!?)\\]]|$)|\\s+(?:and|then|now|so|to|in|for|please|verbatim|exactly|first|before|after|via|into|over|using|out)\\b)|(?:token|secrets?|keys?|passwords?|credentials?|cookies?|sessions?)\\b[^.\\n]{0,100}?send\\s+to\\s+https?://)\\b)|([\\u2800-\\u28FF]{8,})|((?<![A-Za-z0-9+/])(?:[A-Za-z0-9+/]{40,}={0,2}).{0,120}\\b(decode|base64)\\b)"
  ],
