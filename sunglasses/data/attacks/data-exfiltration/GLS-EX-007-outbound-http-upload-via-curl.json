    "curl\\b[^\\n]{0,200}?(?:\\b|(?<!\\S))(?:--data(?:-binary|-raw|-urlencode)?|--form|-d|-F)(?:\\b|(?!\\S))[^\\n]{0,80}?\\$\\(\\s*cat\\s+(?:-\\S+\\s+){0,3}[\\\"']?(?:[^\\s/;|&)\\\"']{0,80}/){0,8}(?![^\\s/;|&)\\\"']*?(?:(?<![A-Za-z0-9])(?:example|sample|template|schema|docs?|documentation|audit|report|fixture|mock|dummy|dist|pub|md|rst|adoc)(?![A-Za-z0-9])|(?<![A-Za-z0-9])(?:example|sample|template|schema|docs?|documentation|audit|report|fixture|mock|dummy)s(?:\\.[A-Za-z0-9]{1,5})?(?![A-Za-z0-9_-])))[^\\s/;|&)\\\"']*?(?:\\.env|\\.npmrc|\\.pypirc|\\.netrc|\\.git-credentials|\\.aws/credentials|id_rsa|id_ed25519|credentials|secret(?:s|)|api(?:_key|-key|key)|access(?:_token|-token|token))(?:\\b|(?!\\S))(?=[^\\s/;|&)\\\"']*(?:[\\s;|&)\\\"']|$))",
    "\\bcat\\s+(?:-\\S+\\s+){0,3}[\\\"']?(?:[^\\s/;|&)\\\"']{0,80}/){0,8}(?![^\\s/;|&)\\\"']*?(?:(?<![A-Za-z0-9])(?:example|sample|template|schema|docs?|documentation|audit|report|fixture|mock|dummy|dist|pub|md|rst|adoc)(?![A-Za-z0-9])|(?<![A-Za-z0-9])(?:example|sample|template|schema|docs?|documentation|audit|report|fixture|mock|dummy)s(?:\\.[A-Za-z0-9]{1,5})?(?![A-Za-z0-9_-])))[^\\s/;|&)\\\"']*?(?:\\.env|\\.npmrc|\\.pypirc|\\.netrc|\\.git-credentials|\\.aws/credentials|id_rsa|id_ed25519|credentials|secret(?:s|)|api(?:_key|-key|key)|access(?:_token|-token|token))(?:\\b|(?!\\S))(?=[^\\s/;|&)\\\"']*(?:[\\s;|&)\\\"']|$))[^\\n|;&]{0,40}\\|\\s*curl\\b[^\\n]{0,200}?(?:\\b|(?<!\\S))(?:(?:--data(?:-binary|-urlencode)?|--json|-d)(?:\\b|(?!\\S))\\s*[\\\"']?@-(?![\\w./-])|(?:--form|-F)(?:\\b|(?!\\S))\\s*[\\\"']?[^\\s\\\"'=@]{1,40}=@-(?![\\w./-])|(?:--upload-file|-T)(?:\\b|(?!\\S))\\s*-(?![\\w./-]))"
